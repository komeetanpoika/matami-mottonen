# Postgres (compose)
POSTGRES_PASSWORD=change-me
WEB_PORT=8080

# App — with APP_ENV=production (set by docker-compose.yml) the API refuses to
# boot while any of the four secrets below still holds its placeholder.
APP_SECRET_KEY=change-me-long-random           # openssl rand -hex 32; min 32 chars, no placeholders
APP_PUBLIC_BASE_URL=https://matami.example.fi  # no trailing slash; used in Stripe return URLs
APP_ADMIN_EMAIL=matami@example.com
APP_ADMIN_PASSWORD=change-me                   # only used to create the first admin; must be changed
APP_CONTACT_EMAIL=matami@example.com           # shown in confirmation emails

# Stripe (dashboard → Developers → API keys / Webhooks)
# Real values only: boot refuses a key that is not sk_… / whsec_….
APP_STRIPE_SECRET_KEY=sk_live_...
APP_STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP for confirmation emails (leave APP_SMTP_HOST empty to only log)
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=matami@example.com
